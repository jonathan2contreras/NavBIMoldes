# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored — never commit it.

# Public domain (DNS A record must point to this VPS). No https://, no trailing slash.
DOMAIN=bimtracker.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com

# MongoDB credentials (internal only). Use URL-safe values, e.g. `openssl rand -hex 24`.
MONGO_USER=bimtracker
MONGO_PASSWORD=change-me
DB_NAME=bimtracker

# Emergent key for object storage (photo/PDF uploads). Optional; uploads are disabled without it.
EMERGENT_LLM_KEY=
